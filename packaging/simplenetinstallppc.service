# SimpleNetInstallPPC as a systemd service (optional). `packaging/install.sh --service`
# installs it as /etc/systemd/system/simplenetinstallppc.service.
#
# The network settings (interface, DHCP mode, pool) are the ones last applied
# on the web UI's Network page or given to `serve`, saved in
# /var/lib/netboot-server/db.sqlite. To add command-line options, run
#   sudo systemctl edit simplenetinstallppc
# and override ExecStart (an empty ExecStart= line first, then the new one).

[Unit]
Description=SimpleNetInstallPPC NetInstall server for PowerPC Macs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/simplenetinstallppc serve
# Reload the image list (new or changed images) without stopping.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# Runs as root: it binds ports 67, 69, 80 and 111, mounts Mac discs and
# images (loop + hfsplus), and reads disc images in users' home folders.
# What root may do is still narrowed down:
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_BROADCAST CAP_NET_ADMIN \
    CAP_SYS_ADMIN CAP_SYS_MODULE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH \
    CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_KILL
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK AF_PACKET
LockPersonality=yes

[Install]
WantedBy=multi-user.target
